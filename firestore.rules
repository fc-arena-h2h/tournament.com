rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    
    function hasRole(role) {
      return isSignedIn() && exists(getUserDoc()) && get(getUserDoc()).data.role == role;
    }
    
    function isAdmin() {
      return (isSignedIn() && request.auth.token.email == 'sperkplay@gmail.com') || hasRole('admin');
    }
    
    function isPublisher() {
      return hasRole('publisher') || isAdmin();
    }

    // User profiles - Hardened security: users cannot increase wallet arbitrarily or change role,
    // except a one-time 10 BDT bonus when publisher creates their first virtual card on an unrecorded device
    match /users/{uid} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isOwner(uid) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isVerified']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['wallet']) ||
          request.resource.data.wallet <= resource.data.wallet ||
          (
            // Publisher first card bonus condition: wallet increased by at most 10 and bonusClaimed becomes true
            request.resource.data.wallet <= resource.data.wallet + 10 &&
            request.resource.data.bonusClaimed == true &&
            (!('bonusClaimed' in resource.data) || resource.data.bonusClaimed != true)
          ) ||
          isAdmin()
        )
      );
      allow delete: if isAdmin();
    }

    // Hardware devices registry to prevent multiple bonus collections on the same device
    match /devices/{hwid} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Tournaments
    match /tournaments/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Registrations
    match /registrations/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Matches
    match /matches/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
    
    // Challenges (1v1)
    match /challenges/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Messages / Global Chat / Match Chat
    match /messages/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
    
    // Announcements
    match /announcements/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Point Transactions
    match /point_transactions/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    // Transactions / Wallet Requests - Hardened: users can only create pending requests for themselves, only admin can approve/update
    match /transactions/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.status == 'pending' && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Leagues
    match /leagues/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // League Memberships
    match /leagueMemberships/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // League Messages (Chat)
    match /leagueMessages/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Notifications
    match /notifications/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }
  }
}
