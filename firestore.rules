rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      // Allow Google users even if verification flag is transiently false during first login
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('email', '') == 'sperkplay@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'admin')
      );
    }

    function isPublisherOf(tournamentId) {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/tournaments/$(tournamentId)) && 
         get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.get('publisherId', '') == request.auth.uid)
      );
    }

    function isPublisher() {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'publisher')
      );
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email == request.auth.token.email
        && data.role in ['player', 'publisher', 'admin']
        && (data.inGameName is string && data.inGameName.size() <= 100)
        && (!('inGameUID' in data) || (data.inGameUID is string))
        && (!('fbUrl' in data) || (data.fbUrl is string))
        && (!('messengerLink' in data) || (data.messengerLink is string))
        && (!('leagueMessengerGroupLink' in data) || (data.leagueMessengerGroupLink is string))
        && (!('whatsappNumber' in data) || (data.whatsappNumber is string))
        && (!('leagueName' in data) || (data.leagueName is string))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40));
    }

    function isValidTournament(data) {
      return data.title is string && data.title.size() <= 200
        && data.publisherId == request.auth.uid
        && data.status in ['open', 'registration_closed', 'ongoing', 'finished', 'completed']
        && data.format in ['group_knockout', 'knockout']
        && data.entryType in ['public', 'invited']
        && (!('activationKey' in data) || (data.activationKey is string))
        && (!('invitationKey' in data) || (data.invitationKey == null || data.invitationKey is string))
        && (!('messengerGroupLink' in data) || (data.messengerGroupLink is string))
        && (!('description' in data) || (data.description is string))
        && (!('organizerName' in data) || (data.organizerName is string))
        && (!('organizationName' in data) || (data.organizationName is string))
        && (!('publisherName' in data) || (data.publisherName is string))
        && (!('prizePool' in data) || (data.prizePool is string))
        && (!('rewardType' in data) || (data.rewardType is string))
        && (!('prizes' in data) || (data.prizes is map || data.prizes == null))
        && (!('totalSlots' in data) || (data.totalSlots is number))
        && (!('filledSlots' in data) || (data.filledSlots is number))
        && (!('createdAt' in data) || (data.createdAt is timestamp));
    }

    function isValidMatch(data) {
      return data.tournamentId is string
        && data.homePlayerId is string
        && data.awayPlayerId is string
        && data.status in ['scheduled', 'reported', 'disputed', 'completed', 'draft']
        && (data.participants is list && data.participants.size() <= 2)
        && (!('homeScore' in data) || data.homeScore is number)
        && (!('awayScore' in data) || data.awayScore is number)
        && (!('reporterId' in data) || data.reporterId is string)
        && (!('groupId' in data) || data.groupId is string)
        && (!('stage' in data) || data.stage is string)
        && (!('matchId' in data) || data.matchId is string)
        && (!('homePlayerName' in data) || data.homePlayerName is string)
        && (!('awayPlayerName' in data) || data.awayPlayerName is string)
        && (!('scheduledTime' in data) || data.scheduledTime is timestamp)
        && (!('screenshotUrl' in data) || data.screenshotUrl is string)
        && (!('disputeReason' in data) || data.disputeReason is string)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidRegistration(data) {
      return data.tournamentId is string
        && data.userId == request.auth.uid
        && data.status in ['pending', 'approved', 'rejected']
        && (data.createdAt <= request.time || !('createdAt' in data));
    }

    function isValidLicenseKey(data) {
      return data.key is string && data.key.size() >= 5
        && data.status in ['active', 'used']
        && (data.createdBy == request.auth.uid || !('createdBy' in data))
        && (data.createdAt <= request.time || !('createdAt' in data));
    }

    function isValidNotification(data) {
      return data.recipientId is string && data.recipientId.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.message is string && data.message.size() <= 1000
        && data.type is string
        && data.read is bool
        && (!('linkTab' in data) || data.linkTab is string)
        && (!('tournamentId' in data) || data.tournamentId == null || data.tournamentId is string)
        && (!('matchId' in data) || data.matchId == null || data.matchId is string)
        && (!('extra' in data) || data.extra == null || data.extra is map)
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // --- Collection Matches ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().role in ['player', 'publisher'] || (incoming().role == 'admin' && incoming().email == 'sperkplay@gmail.com')
      );
      allow update: if (isOwner(userId) && isValidUser(incoming()) && (
        // Action: Update Profile
        (incoming().diff(existing()).affectedKeys().hasOnly(['inGameName', 'inGameUID', 'leagueName', 'fbUrl', 'messengerLink', 'whatsappNumber', 'phone', 'pushEnabled', 'fcmTokens', 'updatedAt']))
        && incoming().role == existing().role
      )) || isAdmin();
    }

    // Tournaments Collection
    match /tournaments/{tournamentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidTournament(incoming());
      allow update, delete: if isAdmin() || (isPublisher() && existing().publisherId == request.auth.uid);
    }

    function isParticipantOf(tournamentId) {
      let regPath = /databases/$(database)/documents/registrations/$(request.auth.uid + "_" + tournamentId);
      return exists(regPath);
    }

    // Registrations Collection
    match /registrations/{registrationId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isPublisherOf(resource.data.tournamentId) ||
        isParticipantOf(resource.data.tournamentId)
      ));
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isPublisherOf(resource.data.tournamentId)
      );
      allow create: if isSignedIn() && isValidRegistration(incoming());
      allow update: if isAdmin() || isPublisherOf(existing().tournamentId);
      allow delete: if isAdmin() || isPublisherOf(existing().tournamentId);
    }

    // Matches Collection
    match /matches/{matchId} {
      allow get, list: if isAdmin() || (isSignedIn() && (
        (request.auth.uid in resource.data.participants) ||
        isPublisherOf(resource.data.tournamentId) ||
        isParticipantOf(resource.data.tournamentId)
      ));
      allow create: if isPublisherOf(incoming().tournamentId) && isValidMatch(incoming());
      allow update: if isAdmin() || 
        isPublisherOf(existing().tournamentId) ||
        (isSignedIn() && (request.auth.uid == existing().homePlayerId || request.auth.uid == existing().awayPlayerId) &&
          (
            // Action: Report Result
            (existing().status == 'scheduled' && incoming().status == 'reported' && 
             (get(/databases/$(database)/documents/tournaments/$(existing().tournamentId)).data.get('resultUploadType', 'players') == 'players') &&
             incoming().diff(existing()).affectedKeys().hasOnly(['homeScore', 'awayScore', 'status', 'reporterId', 'updatedAt', 'penaltyWinnerId'])) ||
            // Action: Confirm Result (Opponent)
            (existing().status == 'reported' && incoming().status == 'completed' && existing().reporterId != request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
            // Action: Dispute Result
            (existing().status == 'reported' && incoming().status == 'disputed' && existing().reporterId != request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'disputeReason', 'updatedAt']))
          )
        ) && isValidMatch(incoming());
      allow delete: if isAdmin() || isPublisherOf(existing().tournamentId) || (isSignedIn() && existing().get('publisherId', '') == request.auth.uid);
    }

    // Announcements
    match /announcements/{announcementId} {
      allow get, list: if isSignedIn();
      allow create, delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow get, list: if isSignedIn() && (
        resource.data.recipientId == request.auth.uid || 
        resource.data.recipientId == 'all' || 
        (isAdmin() && resource.data.recipientId == 'admin')
      );
      allow create: if isSignedIn() && (
        // Allow admins/publishers more freedom, but ensure basic validation for others
        (isAdmin() || isPublisher() || isValidNotification(incoming()))
      );
      allow update: if (isOwner(resource.data.recipientId) || (isAdmin() && resource.data.recipientId == 'admin')) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.recipientId == request.auth.uid);
    }

    // License Keys
    match /licenseKeys/{keyId} {
      allow list: if isAdmin();
      allow get: if isSignedIn();
      allow create: if isAdmin() && isValidLicenseKey(incoming());
      allow update: if isAdmin() || (
        isSignedIn() && 
        existing().status == 'active' && 
        incoming().status == 'used' && 
        incoming().usedBy == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'usedBy', 'usedAt'])
      );
      allow delete: if isAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }

    // Messages
    match /messages/{messageId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isAdmin() || isPublisherOf(resource.data.tournamentId);
    }

    // system_config
    match /system_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Test Connection
    match /test/{testId} {
      allow read, write: if isSignedIn();
    }
  }
}
