rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }

    match /users/{uid} {
      allow read, write: if true;
    }

    match /matches/{id} {
      allow read, write: if true;
    }

    match /tournaments/{id} {
      allow read, write: if true;
    }

    match /registrations/{id} {
      allow read, write: if true;
    }

    match /messages/{id} {
      allow read, write: if true;
    }
  }
}
