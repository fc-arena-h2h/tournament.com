{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["player", "publisher", "admin"] },
        "inGameName": { "type": "string", "maxLength": 100 },
        "inGameUID": { "type": "string", "maxLength": 50 },
        "leagueName": { "type": "string", "maxLength": 50 },
        "fbUrl": { "type": "string", "maxLength": 200 },
        "messengerLink": { "type": "string", "maxLength": 200 },
        "leagueMessengerGroupLink": { "type": "string", "maxLength": 200 },
        "whatsappNumber": { "type": "string", "maxLength": 40 },
        "phone": { "type": "string", "maxLength": 40 },
        "pushEnabled": { "type": "boolean" },
        "fcmTokens": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "object", "description": "Firestore Timestamp" },
        "updatedAt": { "type": "object", "description": "Firestore Timestamp" }
      },
      "required": ["uid", "email", "role"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Tournament details and configuration",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "organizerName": { "type": "string", "maxLength": 100 },
        "organizationName": { "type": "string", "maxLength": 100 },
        "publisherName": { "type": "string", "maxLength": 100 },
        "publisherId": { "type": "string" },
        "publisherId": { "type": "string" },
        "format": { "type": "string", "enum": ["group_knockout", "knockout"] },
        "entryType": { "type": "string", "enum": ["public", "invited"] },
        "entryFee": { "type": "number" },
        "totalSlots": { "type": "number" },
        "filledSlots": { "type": "number" },
        "prizePool": { "type": "string", "maxLength": 100 },
        "rewardType": { "type": "string", "enum": ["winner_only", "top3"] },
        "activationKey": { "type": "string", "maxLength": 50 },
        "prizes": { "type": "object", "nullable": true },
        "status": { "type": "string", "enum": ["open", "registration_closed", "ongoing", "finished", "completed"] },
        "createdAt": { "type": "object" }
      },
      "required": ["title", "publisherId", "status", "createdAt"]
    },
    "Registration": {
      "title": "Registration",
      "description": "User registration for a tournament",
      "type": "object",
      "properties": {
        "tournamentId": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "gameName": { "type": "string", "maxLength": 50 },
        "gameUid": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "object" }
      },
      "required": ["tournamentId", "userId", "status", "createdAt"]
    },
    "Match": {
      "title": "Match",
      "description": "Tournament match schedule and result",
      "type": "object",
      "properties": {
        "tournamentId": { "type": "string" },
        "homePlayerId": { "type": "string" },
        "awayPlayerId": { "type": "string" },
        "homePlayerName": { "type": "string", "maxLength": 50 },
        "awayPlayerName": { "type": "string", "maxLength": 50 },
        "participants": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["scheduled", "ongoing", "reported", "completed", "disputed"] },
        "stage": { "type": "string", "enum": ["group", "r16", "qtr", "semi", "final"] },
        "homeScore": { "type": "number", "nullable": true },
        "awayScore": { "type": "number", "nullable": true },
        "scheduledTime": { "type": "object" },
        "createdAt": { "type": "object" }
      },
      "required": ["tournamentId", "participants", "status", "scheduledTime", "createdAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Global system announcement",
      "type": "object",
      "properties": {
        "text": { "type": "string", "maxLength": 2000 },
        "senderId": { "type": "string" },
        "senderName": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "object" }
      },
      "required": ["text", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification messages",
      "type": "object",
      "properties": {
        "recipientId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "linkTab": { "type": "string" },
        "tournamentId": { "type": "string", "nullable": true },
        "matchId": { "type": "string", "nullable": true },
        "extra": { "type": "object", "nullable": true },
        "createdAt": { "type": "object" }
      },
      "required": ["recipientId", "title", "message", "type", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/tournaments/{tournamentId}": {
      "schema": { "$ref": "#/entities/Tournament" },
      "description": "Tournaments list"
    },
    "/registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/Registration" },
      "description": "Tournament registration requests"
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/Match" },
      "description": "Tournament match scheduling"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "System wide broadcasts"
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User in-app notifications and alerts"
    },
    "/licenseKeys/{keyId}": {
      "schema": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "used"] },
          "createdBy": { "type": "string" },
          "usedBy": { "type": "string", "nullable": true },
          "createdAt": { "type": "object" },
          "usedAt": { "type": "object", "nullable": true }
        },
        "required": ["key", "status", "createdBy", "createdAt"]
      },
      "description": "Deployment license keys for hosts"
    },
    "/test/{testId}": {
      "schema": { "type": "object", "properties": { "status": { "type": "string" } } },
      "description": "Connection test collection"
    }
  }
}
